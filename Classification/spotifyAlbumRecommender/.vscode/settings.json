{
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.languageServerMode": "default",
    "python.analysis.autoImportCompletions": false,
    //Exclude files & folder in search indexing
    "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/env": true,
    "**/venv": true
    },
    //Exclude files &  folders for watcher service
    "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/env/**": true,
    "**/venv/**": true,
    "env-*": true
  },



}

